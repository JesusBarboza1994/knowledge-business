NODE_ENV="dev"
PORT=3000
PUBLIC_URL=
FRONTEND_URL=http://localhost:5173
# Para varios orígenes usa una lista separada por comas.
FRONTEND_URLS=
# URL pública del icono PNG 512x512 anunciado por el servidor MCP.
BRAND_LOGO_URL=http://localhost:5173/knowvault-icon.png
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

MONGO_URI=mongodb://localhost:27017/knowledge-business
AUTH_TOKEN_SECRET=change-me-in-production
AUTH_TOKEN_TTL=2592000

# MSSQL (OSIS)
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_SERVER=
SQLSERVER_DATABASE=

# AWS — S3 stores asset bytes, SNS sends notifications.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are also accepted.
AWS_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_SNS_ARN=
AWS_S3_BUCKET=
# Only for S3-compatible storage (MinIO, Cloudflare R2).
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Assets. SVG is left out of the allowlist on purpose: it is executable in a browser.
ASSET_MAX_BYTES=10485760
ASSET_ALLOWED_MIMES=image/png,image/jpeg,image/webp,image/gif
